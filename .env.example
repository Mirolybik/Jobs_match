NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL (docker compose поднимает его на localhost:5432)
DATABASE_URL=postgresql://jobsmatch:jobsmatch@localhost:5432/jobsmatch?schema=public

# Секреты должны быть не короче 32 символов
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-another-long-random-string-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173

# true — доверять X-Forwarded-For (включено в docker-compose за Caddy)
TRUST_PROXY=false

# true — отклик возможен только при полном совпадении графика
REQUIRE_SCHEDULE_MATCH=true
